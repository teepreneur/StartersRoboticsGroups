# Starters Robotics Group: HostGator / Apache settings
Options -Indexes
DirectoryIndex index.html

# Force HTTPS (enable AutoSSL in cPanel first so the certificate exists)
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>

AddType video/mp4 .mp4

# Never serve git metadata or docs (cPanel Git may clone straight into this folder)
RedirectMatch 404 /\.git
<FilesMatch "^(DEPLOY\.md|\.gitignore)$">
  Require all denied
</FilesMatch>
